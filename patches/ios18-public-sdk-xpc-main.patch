diff --git a/Source/WebKit/Configurations/BaseXPCService.xcconfig b/Source/WebKit/Configurations/BaseXPCService.xcconfig
--- a/Source/WebKit/Configurations/BaseXPCService.xcconfig
+++ b/Source/WebKit/Configurations/BaseXPCService.xcconfig
@@ -59,7 +59,20 @@
 WK_NO_STATIC_INITIALIZERS_Production__ = $(WK_ERROR_WHEN_LINKING_WITH_STATIC_INITIALIZERS);
 WK_NO_STATIC_INITIALIZERS_Production_NO_ = $(WK_ERROR_WHEN_LINKING_WITH_STATIC_INITIALIZERS);
 
-OTHER_LDFLAGS = $(inherited) $(OTHER_LDFLAGS_STAGED_FRAMEWORK_PATH) $(WK_RELOCATABLE_FRAMEWORKS_LDFLAGS) $(WK_NO_STATIC_INITIALIZERS);
+OTHER_LDFLAGS = $(inherited) $(OTHER_LDFLAGS_STAGED_FRAMEWORK_PATH) $(WK_RELOCATABLE_FRAMEWORKS_LDFLAGS) $(WK_ROOTLESS_FRAMEWORKS_LDFLAGS_$(WK_ROOTLESS_FRAMEWORKS)) $(WK_NO_STATIC_INITIALIZERS);
+
+// The one directory the overridden images are read from. scripts/install-webkit-override.sh
+// builds this same directory and the basebin search-path hook points at it, so a helper process
+// reaches one copy of each framework whether the path arrives from the environment or from this
+// load command. dyld walks a search list in order and stops at the first candidate that resolves,
+// so WK_ROOTLESS_FRAMEWORKS_ROOT coming first is what makes the override win.
+WK_ROOTLESS_FRAMEWORKS_ROOT = /var/jb/Library/WebKitOverride;
+
+WK_ROOTLESS_FRAMEWORKS_LDFLAGS = $(WK_ROOTLESS_FRAMEWORKS_LDFLAGS_$(WK_ROOTLESS_FRAMEWORKS));
+// The trailing entries are the deb install locations. They keep resolving the jbroot files the
+// override deliberately does not carry, such as /var/jb/usr/lib/systemhook.dylib and the
+// CydiaSubstrate framework, and they are only reached when the override has no such image.
+WK_ROOTLESS_FRAMEWORKS_LDFLAGS_YES = -Wl,-dyld_env,DYLD_FRAMEWORK_PATH=$(WK_ROOTLESS_FRAMEWORKS_ROOT):/var/jb/Library/Frameworks -Wl,-dyld_env,DYLD_LIBRARY_PATH=$(WK_ROOTLESS_FRAMEWORKS_ROOT)/usr/lib:/var/jb/usr/lib;
 
 WK_RELOCATABLE_FRAMEWORKS_LDFLAGS = $(WK_RELOCATABLE_FRAMEWORKS_LDFLAGS_$(WK_RELOCATABLE_FRAMEWORKS));
 WK_RELOCATABLE_FRAMEWORKS_LDFLAGS_ = $(WK_RELOCATABLE_FRAMEWORKS_LDFLAGS_NO);

diff --git a/Source/WebKit/Shared/EntryPointUtilities/Cocoa/XPCService/XPCServiceMain.mm b/Source/WebKit/Shared/EntryPointUtilities/Cocoa/XPCService/XPCServiceMain.mm
--- a/Source/WebKit/Shared/EntryPointUtilities/Cocoa/XPCService/XPCServiceMain.mm
+++ b/Source/WebKit/Shared/EntryPointUtilities/Cocoa/XPCService/XPCServiceMain.mm
@@ -31,6 +31,7 @@
 #import "XPCServiceEntryPoint.h"
 #import "XPCUtilities.h"
 #import <CoreFoundation/CoreFoundation.h>
+#import <dlfcn.h>
 #import <mach/mach.h>
 #import <pal/spi/cf/CFUtilitiesSPI.h>
 #import <pal/spi/cocoa/LaunchServicesSPI.h>
@@ -52,4 +53,18 @@
 namespace WebKit {
+
+#if !PLATFORM(MAC) && !PLATFORM(MACCATALYST)
+[[noreturn]] static void runXPCServiceMainRunLoop()
+{
+    // On iPadOS 16.1, dispatch_main calls pthread_exit and libdispatch unbinds
+    // the main queue from the main thread (probe19: main_np=0). CFRunLoopRun
+    // keeps WorkQueue::main().dispatchSync on the main thread (probe20: main_np=1).
+    // This satisfies InitializeWebKit2's main-thread assertion when the
+    // InitializeWebKit2MainThreadAssertion SDK-aligned behavior is disabled.
+    CFRunLoopRun();
+    RELEASE_LOG_FAULT(IPC, "Exiting: XPC service main run loop returned");
+    exitProcess(EXIT_FAILURE);
+}
+#endif
 
 static Vector<String>& overrideLanguagesFromBootstrap()
 {
@@ -271,8 +286,52 @@ int XPCServiceMain(int, const char**)
     setenv("__APPLEEVENTSSERVICENAME", "", 1);
 #endif
 
+#if PLATFORM(MAC) || PLATFORM(MACCATALYST)
     xpc_main(XPCServiceEventHandler);
     return 0;
+#else
+    // xpc_main is marked API_UNAVAILABLE(ios), so reproduce what it does.
+    // What it does is listen, not dial: on this device it reads XPC_SERVICE_NAME and calls
+    // xpc_connection_create_listener, and the handler it wraps receives each connection launchd
+    // accepts, which is the shape XPCServiceEventHandler takes. A client connection instead
+    // receives messages addressed to its own socket and never a connection, so launchd's handshake
+    // cannot arrive. xpc_connection_create_mach_service reaches that same listener constructor
+    // when bit 0 of its flags is set, which is what this branch asks for.
+    //
+    // The SDK declares the entry point as API_UNAVAILABLE(ios), so naming it in a call does not
+    // compile and it is resolved at runtime; a missing symbol ends the process rather than falling back.
+    typedef xpc_connection_t (*CreateMachServiceFunction)(const char*, dispatch_queue_t, uint64_t);
+    static CreateMachServiceFunction createMachService = reinterpret_cast<CreateMachServiceFunction>(dlsym(RTLD_DEFAULT, "xpc_connection_create_mach_service"));
+    if (!createMachService) {
+        RELEASE_LOG_FAULT(IPC, "Exiting: libxpc does not export xpc_connection_create_mach_service");
+        exitProcess(EXIT_FAILURE);
+    }
+
+    const char* xpcServiceName = getenv("XPC_SERVICE_NAME");
+    if (!xpcServiceName) {
+        RELEASE_LOG_FAULT(IPC, "Exiting: XPC_SERVICE_NAME is unset, so there is no service to listen for");
+        exitProcess(EXIT_FAILURE);
+    }
+
+    // XPC_CONNECTION_MACH_SERVICE_LISTENER is bit 0 of the flags argument, defined by the SDK. The
+    // entry point above arrives as a runtime pointer, so the value is written out; libxpc tests
+    // this bit before it creates the listener.
+    static const uint64_t machServiceListenerFlag = 1;
+
+    xpc_connection_t listener = createMachService(xpcServiceName, nullptr, machServiceListenerFlag);
+    xpc_connection_set_event_handler(listener, ^(xpc_object_t event) {
+        if (xpc_get_type(event) == XPC_TYPE_CONNECTION) {
+            XPCServiceEventHandler(event);
+            return;
+        }
+        // A listener yields connections and errors, nothing else, and an error means no connection
+        // will ever arrive. Report it and end instead of idling in the main run loop.
+        RELEASE_LOG_FAULT(IPC, "Exiting: listener received %{public}s instead of a connection", xpc_type_get_name(xpc_get_type(event)));
+        exitProcess(EXIT_FAILURE);
+    });
+    xpc_connection_resume(listener);
+    runXPCServiceMainRunLoop();
+#endif
 }
 
 } // namespace WebKit
