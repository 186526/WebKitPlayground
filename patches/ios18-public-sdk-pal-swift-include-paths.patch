diff --git a/Source/WebCore/PAL/Configurations/PAL.xcconfig b/Source/WebCore/PAL/Configurations/PAL.xcconfig
--- a/Source/WebCore/PAL/Configurations/PAL.xcconfig
+++ b/Source/WebCore/PAL/Configurations/PAL.xcconfig
@@ -84,6 +84,10 @@
 OTHER_SWIFT_FLAGS_xrsimulator = -Xcc -std=c++20 -I $(SRCROOT)/pal -I $(SRCROOT)/PAL/pal;
 OTHER_SWIFT_FLAGS_MACOS_SINCE_1400 = -Xcc -std=c++20 -I $(SRCROOT)/pal -I $(SRCROOT)/PAL/pal;
 OTHER_SWIFT_FLAGS_MACCATALYST_SINCE_14 = -Xcc -std=c++20 -I $(SRCROOT)/pal -I $(SRCROOT)/PAL/pal;
 OTHER_SWIFT_FLAGS_IOS_SINCE_17 = -Xcc -std=c++20 -I $(SRCROOT)/pal -I $(SRCROOT)/PAL/pal;
+// WebKitTargetConditionals.xcconfig:302-304 makes WK_IOS_17 expand to _IOS_BEFORE_17 for every
+// deployment target below 17, and only the _IOS_SINCE_17 suffix carried these include paths.
+// A 16.1 deployment target therefore drops both, and PAL cannot find module PALSwift from pal/.
+OTHER_SWIFT_FLAGS_IOS_BEFORE_17 = -Xcc -std=c++20 -I $(SRCROOT)/pal -I $(SRCROOT)/PAL/pal;
 OTHER_SWIFT_FLAGS_WATCHOS_SINCE_10 = -Xcc -std=c++20 -I $(SRCROOT)/pal -I $(SRCROOT)/PAL/pal;
 OTHER_SWIFT_FLAGS_TVOS_SINCE_17 = -Xcc -std=c++20 -I $(SRCROOT)/pal -I $(SRCROOT)/PAL/pal;
 
