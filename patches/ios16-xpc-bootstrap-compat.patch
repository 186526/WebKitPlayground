+
 bool XPCServiceInitializerDelegate::getClientSDKAlignedBehaviors(SDKAlignedBehaviors& behaviors)
 {
     size_t length = 0;
     auto behaviorData = xpc_dictionary_get_data(m_initializerMessage, "client-sdk-aligned-behaviors", &length);
-    if (!length || !behaviorData)
-        return false;
+    if (!length || !behaviorData) {
+        // A UI process older than 18.x sends the version it was linked against as a decimal string
+        // instead of the behavior bit set. Rebuild the set from that version, so a helper launched
+        // by such a UI process does not start with every behavior disabled. The caller ignores the
+        // return value, so the behaviors have to be filled in here.
+        auto clientSDKVersionString = xpc_dictionary_get_string(m_initializerMessage, "client-sdk-version");
+        if (!clientSDKVersionString)
+            return false;
+        auto clientSDKVersion = parseInteger<uint32_t>(StringView::fromLatin1(clientSDKVersionString));
+        if (!clientSDKVersion)
+            return false;
+        setSDKAlignedBehaviorsFromClientSDKVersion(*clientSDKVersion, behaviors);
+        return true;
+    }
     RELEASE_ASSERT(length == behaviors.storageLengthInBytes());
     memcpy(behaviors.storage(), behaviorData, length);
 
