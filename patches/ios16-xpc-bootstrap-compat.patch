+    // No foreign bitmap is copied, at any width, because none of them can be read correctly.
+    // SDKAlignedBehaviors is a bit set indexed by SDKAlignedBehavior, and that enumeration gained,
+    // lost and reordered members between releases, so equal widths do not mean equal layouts.
+    // Measured against this tree's own list:
+    //
+    //   18.3.1 (this build)  94 behaviors, 12 bytes
+    //   18.0                93 behaviors, 12 bytes, same index at 53 of 93 positions, and it both
+    //                       adds NoSearchInputIncrementalAttributeAndSearchEvent off the tail and
+    //                       lacks two names this build has
+    //   17.0                79 behaviors, 12 bytes, same index at 3 of 79
+    //   16.4                73 behaviors, 12 bytes, same index at 3 of 73
+    //   16.2 / 16.3         64 behaviors,  8 bytes, same index at 3 of 64
+    //   16.0 / 16.1         63 behaviors,  8 bytes, same index at 3 of 63
+    //
+    // The width only separates 16.0 through 16.3, which are two words, from 16.4 onwards, which
+    // are three. It does not identify a generation whose bits match this build's, so there is no
+    // width whose payload is safe to copy. memcpy on any of them would leave the helper running
+    // under a near-arbitrary set of unrelated behaviors, which is worse than not crashing.
+    //
+    // What this function therefore guarantees is a defined bitmap, not a translated one: the
+    // argument arrives zero-initialised, so leaving it alone applies the default-off set that
+    // WTF::computeSDKAlignedBehaviors produces for a client linked before every behavior.
+    //
+    // There is deliberately no fallback on the "client-sdk-version" bootstrap key either. WebKit
+    // for iOS 16.0 stopped writing and reading it, so no 16.x peer has ever sent it to this helper.
+    const size_t ownLength = behaviors.storageLengthInBytes();
+
+    if (length <= ownLength)
+        RELEASE_LOG_ERROR(IPC, "UI process sent a %zu-byte SDK aligned behavior bitmap, which is not this build's %zu-byte layout; every SDK aligned behavior stays at its default", length, ownLength);
+    else
+        RELEASE_LOG_ERROR(IPC, "UI process sent a %zu-byte SDK aligned behavior bitmap, wider than this build's %zu bytes, so it comes from a newer generation; every SDK aligned behavior stays at its default", length, ownLength);
+
+    // Reported distinctly so a caller can tell a peer that sent nothing from one whose payload
+    // was rejected. The caller ignores the value, as it always has.
+    return length <= ownLength;
 }
 
