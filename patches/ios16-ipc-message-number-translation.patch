+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#pragma once
+
+#include "MessageNames.h"
+
+#include <cstdint>
+#include <optional>
+
+// A UI process on iOS 16 speaks the message enumeration that system shipped
+// with, which is not the one this tree compiles: `MessageName` is a dense
+// enumeration over every message in the tree, so a list that grew by 946
+// entries reassigns almost every number even where names match. The two
+// functions below convert between the two numberings; the tables they switch
+// over are generated by scripts/gen-ipc-message-number-tables.py.
+//
+// This gate decides whether the tables are compiled in at all, not whether any
+// given connection uses them. It is the deployment target because a build aimed
+// at iOS 16 is the only one that can be asked to support an older UI process; a
+// build aimed at iOS 18 would never meet one. Which connections actually
+// translate is decided at run time from the peer's own SDK version, read from
+// the bootstrap dictionary - a build that targets iOS 16 and runs under an iOS 18
+// UI process still pays nothing for the switch.
+#if PLATFORM(IOS) && defined(__IPHONE_OS_VERSION_MIN_REQUIRED) && __IPHONE_OS_VERSION_MIN_REQUIRED < 180000
+#define IOS_16_MESSAGE_NUMBER_TRANSLATION 1
+#else
+#define IOS_16_MESSAGE_NUMBER_TRANSLATION 0
+#endif
+
+#if IOS_16_MESSAGE_NUMBER_TRANSLATION
+
+namespace IPC {
+
+// Converts a message number this build assigned into the number the iOS 16
+// enumeration assigns to the same message, for a message about to be sent to an
+// iOS 16 UI process. Returns the input unchanged when this build has a message
+// the older enumeration does not name.
+MessageName translateOutgoingMessageName(MessageName);
+
+// Converts a message number received from an iOS 16 UI process into the number
+// this build assigns to the same message. Returns the input unchanged when the
+// older enumeration names something this build does not.
+MessageName translateIncomingMessageName(MessageName);
+
+// The SDK version the UI process put in the bootstrap dictionary, or nullopt
+// when it did not send one. Decided at process start, before any message can be
+// received, so the translation decision does not depend on compile-time state.
+//
+// Whether to translate is a property of the peer, not of this binary: an iOS 16
+// deployment target means this build *can* talk to a 16 UI process, not that it
+// will. Only a peer that numbered its messages with the older enumeration needs
+// the tables, and the bootstrap dictionary is where it says so.
+void setUIProcessSDKVersionFromBootstrap(std::optional<uint32_t>);
+std::optional<uint32_t> uiProcessSDKVersionFromBootstrap();
+
+} // namespace IPC
+
+#endif // IOS_16_MESSAGE_NUMBER_TRANSLATION
