+#include <wtf/spi/darwin/dyldSPI.h>
 #include <wtf/WTFProcess.h>
 
 #if !OS(WINDOWS)
@@ -106,6 +108,23 @@ void AuxiliaryProcess::initialize(const AuxiliaryProcessInitializationParameters
     WebPageProxyIdentifier::enableGenerationProtection();
 
     m_connection = IPC::Connection::createClientConnection(parameters.connectionIdentifier);
+#if IOS_16_MESSAGE_NUMBER_TRANSLATION
+    // This is the only connection that leaves the process for the UI process, and
+    // the UI process may be an older WebKit build than this one: a WebContent, GPU
+    // or Network process launched by an iOS 16 Safari runs this build while the UI
+    // process keeps 16's numbering. Every other connection this process opens is
+    // with a peer of the same build.
+    //
+    // Whether the peer is older is read from the bootstrap dictionary rather than
+    // assumed from the deployment target, because a build that targets iOS 16 can
+    // still be launched by an iOS 18 UI process. A peer that sent no version is
+    // treated as not needing translation: passing its correctly numbered messages
+    // through unchanged fails visibly at the protocol layer if the assumption is
+    // wrong, while rewriting numbers on a same-generation connection would corrupt
+    // messages that were already correct and fail less legibly.
+    if (auto version = IPC::uiProcessSDKVersionFromBootstrap(); version && *version < DYLD_IOS_VERSION_18_0)
+        m_connection->setShouldTranslateMessageNames(true);
+#endif
     initializeConnection(m_connection.get());
     m_connection->open(*this);
 }
