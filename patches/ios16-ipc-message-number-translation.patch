+#if IOS_16_MESSAGE_NUMBER_TRANSLATION
+    // Must run before the InitializeConnection comparison below: that message
+    // arrives numbered by the sender's enumeration, and everything downstream
+    // dispatches on the number too.
+    //
+    // An unmapped number is flagged, not translated. translateIncomingMessageName
+    // cannot name a message this build does not have, and answering
+    // MessageName::Invalid would be worse: Invalid is Count, which compares
+    // greater than FirstSynchronous, and receiverName() clamps it to Last, so the
+    // message would be dispatched as a synchronous message under the receiver
+    // that owns the last number in this build's enumeration. Nothing would
+    // report that the message was never understood.
+    if (m_shouldTranslateMessageNames) {
+        auto translated = translateIncomingMessageName(decoder->messageName());
+        if (translated == MessageName::Invalid)
+            decoder->setDroppedByTranslation();
+        else
+            decoder->setMessageName(translated);
+    }
+#endif
+
 #if PLATFORM(MAC)
     decoder->setImportanceAssertion(ImportanceAssertion { header });
 #endif
