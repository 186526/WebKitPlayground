+void Encoder::setMessageName(MessageName name)
+{
+    // Rewrites the bytes encodeHeader() wrote and leaves the member alone. The
+    // member must keep the value this build's enumeration assigns because
+    // receiverName() indexes this build's messageDescriptions table with it, so
+    // storing the peer's numbering there would report the wrong receiver. The
+    // buffer is what the peer actually reads.
+    //
+    // encodeHeader() wrote the flags byte first; grow() then aligned the name to
+    // alignof(MessageName), so for this uint16_t the name occupies bytes 2 and 3
+    // and byte 1 is padding.
+    size_t messageNameOffset = roundUpToAlignment(sizeof(defaultMessageFlags), alignof(MessageName));
+    auto bytes = asBytes(std::span { &name, 1 });
+    ASSERT(messageNameOffset + bytes.size() <= m_bufferSize);
+    memcpySpan(m_capacityBuffer.subspan(messageNameOffset, bytes.size()), bytes);
+}
