diff --git a/Source/WebKit/Platform/IPC/MessageNumberTranslation.h b/Source/WebKit/Platform/IPC/MessageNumberTranslation.h
new file mode 100644
index 0000000000..32332daae6
--- /dev/null
+++ b/Source/WebKit/Platform/IPC/MessageNumberTranslation.h
@@ -0,0 +1,81 @@
+/*
+ * Copyright (C) 2010-2020 Apple Inc. All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
