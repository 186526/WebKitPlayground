+bool XPCServiceInitializerDelegate::getUIProcessSDKVersion(std::optional<uint32_t>& version)
+{
+    // The iOS 16 UI process records its own SDK version here as a decimal string
+    // (ProcessLauncherCocoa.mm writes "client-sdk-version" into the bootstrap
+    // dictionary). A peer that does not send it leaves the value absent, which is
+    // distinct from a peer that sent a version modern enough not to need
+    // translation, so the two cases are kept apart.
+    auto* versionString = xpc_dictionary_get_string(m_initializerMessage, "client-sdk-version");
+    if (!versionString)
+        return false;
+    auto parsedVersion = parseInteger<uint32_t>(StringView::fromLatin1(versionString));
+    if (!parsedVersion)
+        return false;
+    version = *parsedVersion;
+    return true;
+}
