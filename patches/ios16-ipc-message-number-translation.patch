+// A process reads this once, at startup, from the bootstrap dictionary the UI
+// process filled in. Written before any connection can receive a message and
+// read only afterwards, so no lock is needed.
+static std::optional<uint32_t>& uiProcessSDKVersionStorage()
+{
+    static std::optional<uint32_t> version;
+    return version;
+}
+
+void setUIProcessSDKVersionFromBootstrap(std::optional<uint32_t> version)
+{
+    uiProcessSDKVersionStorage() = version;
+}
+
+std::optional<uint32_t> uiProcessSDKVersionFromBootstrap()
+{
+    return uiProcessSDKVersionStorage();
+}
