+// True when envp carries name with exactly this value. A spawned process passes its environment
+// down, so a child of an already overridden parent matches here and keeps its envp untouched
+// instead of rebuilding the buffer and appending another copy on every generation.
+// Both values are non-NULL at every call site: the caller clears the enabled flag when JBROOT_PATH
+// returned NULL, and nothing below runs then, so NULL never reaches strcmp or envbuf_setenv.
+static bool envbuf_variable_matches(const char *envp[], const char *name, const char *wanted)
+{
+	const char *existingValue = envbuf_getenv(envp, name);
+	return existingValue && !strcmp(existingValue, wanted);
+}
+
+// The search paths this hook hands to spawned processes, and what is already in place.
+#define JB_SEARCH_PATH_COUNT 4
+
+typedef struct {
+	const char *name;
+	const char *value;
+} jbSearchPathVariable;
+
+typedef struct {
+	bool enabled;
+	bool present[JB_SEARCH_PATH_COUNT];
+	bool allPresent;
+	bool anyPresent;
+} jbSearchPathState;
+
+// Records which variables already hold the value this hook would write. With the switch off
+// nothing is compared, and both aggregates keep the values that leave the fast paths and both
+// branches behaving exactly as the unpatched code did.
+static jbSearchPathState jbSearchPathStateFor(const char *envp[], bool enabled, const jbSearchPathVariable variables[JB_SEARCH_PATH_COUNT])
+{
+	jbSearchPathState state = { .enabled = enabled, .present = { false }, .allPresent = true, .anyPresent = false };
+	if (!enabled) return state;
+	for (int i = 0; i < JB_SEARCH_PATH_COUNT; i++) {
+		state.present[i] = envbuf_variable_matches(envp, variables[i].name, variables[i].value);
+		if (state.present[i]) {
+			state.anyPresent = true;
+		}
+		else {
+			state.allPresent = false;
+		}
+	}
+	return state;
+}
+
+// Writes the variables that are not already in place. With the switch off nothing is written.
+static void jbSearchPathSet(char **envpp[], const jbSearchPathVariable variables[JB_SEARCH_PATH_COUNT], const jbSearchPathState *state)
+{
+	if (!state->enabled) return;
+	for (int i = 0; i < JB_SEARCH_PATH_COUNT; i++) {
+		if (!state->present[i]) envbuf_setenv(envpp, variables[i].name, variables[i].value);
+	}
+}
+
+// Removes only the values this hook would have written, so a third party that set the same
+// variable for its own purposes keeps it. With the switch off nothing is removed.
+static void jbSearchPathUnset(char **envpp[], const jbSearchPathVariable variables[JB_SEARCH_PATH_COUNT], const jbSearchPathState *state)
+{
+	if (!state->enabled) return;
+	for (int i = 0; i < JB_SEARCH_PATH_COUNT; i++) {
+		if (state->present[i]) envbuf_unsetenv(envpp, variables[i].name);
+	}
+}
+
