@@ -145,10 +145,23 @@ static kSpawnConfig spawn_config_for_executable(const char* path, char *const ar
 	return (kSpawnConfigInject | kSpawnConfigTrust);
 }
 
+// True when envp carries name with exactly this value. A spawned process passes its environment
+// down, so a child of an already overridden parent matches here and keeps its envp untouched
+// instead of rebuilding the buffer and appending another copy on every generation.
+// wanted is NULL when JBROOT_PATH could not resolve the jailbreak root; nothing can match then.
+static bool envbuf_variable_matches(const char *envp[], const char *name, const char *wanted)
+{
+	if (wanted == NULL) return false;
+	const char *existingValue = envbuf_getenv(envp, name);
+	return existingValue && !strcmp(existingValue, wanted);
+}
+
 // 1. Ensure the binary about to be spawned and all of it's dependencies are trust cached
 // 2. Insert "DYLD_INSERT_LIBRARIES=/usr/lib/systemhook.dylib" into all binaries spawned
 // 3. Increase Jetsam limit to more sane value (Multipler defined as JETSAM_MULTIPLIER)
 // 4. Fix spawning as root via persona entitlement on iOS 17.6+
+// 5. Point dyld's framework and library search paths at the jailbreak root, so a WebKit built
+//    outside the shared cache can be reached from /var/jb/Library/WebKitOverride
 
 static int spawn_exec_hook_common(bool isExec,
 						   const char *path,
@@ -193,6 +206,56 @@ static int spawn_exec_hook_common(bool isExec,
 		});
 	}
 
+	// Two directories, both dedicated to this override. Every name in a search path becomes a
+	// candidate for every spawned process, and the shared directories hold other packages' files:
+	// /var/jb/Library/Frameworks carries AltList and CydiaSubstrate, while /var/jb/usr/lib shares
+	// liblzma.5.dylib and libmrc.dylib with the shared cache.
+	// JBROOT_PATH goes through get_jbroot(), which this dylib answers from the check-in that
+	// initializer() performs before it installs the spawn hooks, so both paths are usable here.
+	const char *jbFrameworkPath = JBROOT_PATH("/Library/WebKitOverride");
+	const char *jbLibraryPath = JBROOT_PATH("/Library/WebKitOverride/usr/lib");
+
+	// The framework directory takes WebKit.framework/WebKit and friends. The library directory
+	// takes bare file names: dyld reduces an install name such as
+	// /System/Library/PrivateFrameworks/WebCore.framework/Frameworks/libwebrtc.dylib to its leaf
+	// and appends only that leaf here, because getFrameworkPartialPath returns NULL for it.
+	struct { const char *name; const char *value; } searchPathVariables[] = {
+		{ "DYLD_FRAMEWORK_PATH",       jbFrameworkPath },
+		{ "__XPC_DYLD_FRAMEWORK_PATH", jbFrameworkPath },
+		{ "DYLD_LIBRARY_PATH",         jbLibraryPath },
+		{ "__XPC_DYLD_LIBRARY_PATH",   jbLibraryPath },
+	};
+	const int searchPathVariableCount = (int)(sizeof(searchPathVariables) / sizeof(searchPathVariables[0]));
+
+	// A DisableJBFrameworkPath boolean in /var/jb/basebin/config.plist turns this off without a
+	// rebuild. With the key absent, or the file unreadable, the search paths stay on.
+	xpc_object_t disableSearchPath = jbuserconfig_get_value("DisableJBFrameworkPath");
+	bool enableSearchPath = jbFrameworkPath != NULL && jbLibraryPath != NULL;
+	if (enableSearchPath && disableSearchPath) {
+		if (xpc_get_type(disableSearchPath) == XPC_TYPE_BOOL && xpc_bool_get_value(disableSearchPath)) {
+			enableSearchPath = false;
+		}
+	}
+
+	// True when that variable already holds the value this hook would write. With the switch off,
+	// the two flags below take the values that leave both fast paths exactly as they were.
+	bool searchPathPresent[sizeof(searchPathVariables) / sizeof(searchPathVariables[0])];
+	bool allSearchPathsPresent = true;
+	bool anySearchPathPresent = false;
+	for (int i = 0; i < searchPathVariableCount; i++) {
+		searchPathPresent[i] = envbuf_variable_matches((const char **)envp, searchPathVariables[i].name, searchPathVariables[i].value);
+		if (searchPathPresent[i]) {
+			anySearchPathPresent = true;
+		}
+		else {
+			allSearchPathsPresent = false;
+		}
+	}
+	if (!enableSearchPath) {
+		allSearchPathsPresent = true;
+		anySearchPathPresent = false;
+	}
+
 	int JBEnvAlreadyInsertedCount = (int)systemHookAlreadyInserted;
 
 	// Check if we can find at least one reason to not insert jailbreak related environment variables
@@ -313,7 +376,8 @@ static int spawn_exec_hook_common(bool isExec,
 
 	pid_t childPid = -1;
 
-	if ((shouldInsertJBEnv && JBEnvAlreadyInsertedCount == 1) || (!shouldInsertJBEnv && JBEnvAlreadyInsertedCount == 0 && !hasSafeModeVariable)) {
+	if ((shouldInsertJBEnv && JBEnvAlreadyInsertedCount == 1 && allSearchPathsPresent) ||
+		(!shouldInsertJBEnv && JBEnvAlreadyInsertedCount == 0 && !hasSafeModeVariable && !anySearchPathPresent)) {
 		// we're already good, just call orig
 		r = orig(&childPid, envp);
 	}
@@ -332,6 +396,12 @@ static int spawn_exec_hook_common(bool isExec,
 				}
 				envbuf_setenv(&envc, "DYLD_INSERT_LIBRARIES", newLibraryInsert);
 			}
+
+			// The bare variables cover the spawned process itself. An XPC service such as
+			// WebContent is started through xpcproxy, which passes along the __XPC_ copy.
+			for (int i = 0; i < searchPathVariableCount; i++) {
+				if (!searchPathPresent[i]) envbuf_setenv(&envc, searchPathVariables[i].name, searchPathVariables[i].value);
+			}
 		}
 		else {
 			if (systemHookAlreadyInserted && existingLibraryInserts) {
@@ -360,6 +430,11 @@ static int spawn_exec_hook_common(bool isExec,
 					free(newLibraryInsert);
 				}
 			}
+			// Only drop the value this hook would have written, so a third party that set the
+			// same variable for its own purposes keeps it.
+			for (int i = 0; i < searchPathVariableCount; i++) {
+				if (searchPathPresent[i]) envbuf_unsetenv(&envc, searchPathVariables[i].name);
+			}
 			envbuf_unsetenv(&envc, "_SafeMode");
 			envbuf_unsetenv(&envc, "_MSSafeMode");
 		}
